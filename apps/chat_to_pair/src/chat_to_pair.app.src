    {registered, []},
    {mod, {chat_to_pair_app, []}},
    {applications, [
        kernel, stdlib, crypto, inets, ssl, jsx
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]}
]}.
