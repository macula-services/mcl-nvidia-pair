{application, mcl_nvidia_pair, [
    {description, "Realm-scoped bridge from a Macula realm to a local NVIDIA PAIR cluster"},
    {vsn, "0.1.0"},
    {registered, [mcl_nvidia_pair_sup]},
    {mod, {mcl_nvidia_pair_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% The two slices: the forward to PAIR, and the per-caller limit.
        chat_to_pair,
        throttle_pair_callers
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-nvidia-pair"}]}
]}.
