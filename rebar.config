%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_nvidia_pair.
%%
%% Realm-scoped bridge from a Macula realm to a local NVIDIA PAIR cluster
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. No store: the service module
    %% exports no store_id/0 + data_dir/0. 0.27 labels the boot claim with
    %% MCL_SERVICE_NAME / MCL_BOX, which the realm's Providers desk shows, and
    %% no longer brings barrel_docdb or rocksdb.
    %% 0.28 answers `Org/info' for the service and is the release macula 12.2
    %% needs: under 12.2 an older mcl_om lets a failed publish announcement
    %% kill the publishing process.
    {mcl_om, "~> 0.28"},
    %% chat_to_pair encodes PAIR's request and decodes its reply.
    {jsx, "~> 3.1"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_nvidia_pair, "0.1.0"}, [mcl_nvidia_pair, chat_to_pair, throttle_pair_callers, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for httpc (chat_to_pair_tests) and for chat_to_pair
    %% itself (mcl_nvidia_pair_mesh_rpc_tests).
    {test, [{deps, [{meck, "1.2.0"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

%% macula ships to hex without debug_info, so dialyzer cannot read it: its
%% functions show as unknown and its behaviours' callbacks as unavailable.
%% Both classes are suppressed, as mcl_om does; this service's own code is
%% still analysed.
{dialyzer, [{warnings, [no_unknown, no_undefined_callbacks]}]}.
