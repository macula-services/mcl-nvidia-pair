%% test.sys.config — the live test's own environment.
%%
%% Only `live_test' loads this: `rebar3 as live_test eunit --dir test_live'
%% (see rebar.config). CI's gate never reads it, because the live test never
%% runs there — it needs a deployed bridge and a real PAIR cluster.
%%
%% `crypto_profile' is the one setting the test cannot do without: every key it
%% generates, every wire signature it checks and the realm key id it derives
%% are read through macula_crypto_profile:configured(), which refuses an unset
%% profile rather than guessing. pq_hybrid is the fleet's profile.
[
    {macula, [
        {identity_dir, "_build/live_test/identity"},
        {crypto_profile, pq_hybrid}
    ]}
].
